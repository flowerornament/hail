#!/usr/bin/env bash
# hail — agent-to-agent messaging over tmux.
# One-way sends, bodies on disk, a one-line envelope in the recipient's prompt,
# receipts written by delivery (`deliver`, from a hook) or by the recipient's own
# `inbox`, and `await` on top of receipts. See DESIGN.md.
set -euo pipefail

VERSION="0.2.1"

KINDS="ruling go nogo ask fyi done stop hold block release announce"

# --- Helpers ---

die() { echo "error: $*" >&2; exit 1; }
# die with a specific exit code: die_rc <code> <message>
die_rc() { local rc="$1"; shift; echo "error: $*" >&2; exit "$rc"; }

utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# All state lives under one root, outside every repo tree (DESIGN.md §8).
state_root() {
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/hail"
}

inbox_root()       { echo "$(state_root)/inbox"; }
holds_root()       { echo "$(state_root)/holds"; }
obligations_root() { echo "$(state_root)/obligations"; }
identity_root()    { echo "$(state_root)/identity"; }
incarnation_root() { echo "$(state_root)/incarnation"; }
sent_root()        { echo "$(state_root)/sent"; }

# First value of a "field: value" header line in a message/state file.
hdr() { sed -n "s/^$2: //p" "$1" 2>/dev/null | head -1; }

# Sanitize a label for use as a directory name.
key_of_label() { echo "${1//\//_}"; }

# --- Read Guard ---
# Enforces read-before-act: agents must read a pane before typing/keys.

read_guard_path() {
  local pane_id="$1"
  # Sanitize: %66 → _66
  echo "$(state_root)/read/${pane_id//%/_}"
}

mark_read() {
  mkdir -p "$(state_root)/read"
  touch "$(read_guard_path "$1")"
}

require_read() {
  local guard
  guard=$(read_guard_path "$1")
  if [[ ! -f "$guard" ]]; then
    die "must read the pane before interacting. Run: hail read $1"
  fi
}

clear_read() {
  rm -f "$(read_guard_path "$1")"
}

# Detect the correct tmux server socket.
# Priority: HAIL_SOCKET env (TMUX_BRIDGE_SOCKET accepted as a fallback)
#           > $TMUX (if socket alive) > scan for pane owner.
socket_override() {
  if [[ -n "${HAIL_SOCKET:-}" ]]; then echo "$HAIL_SOCKET"
  elif [[ -n "${TMUX_BRIDGE_SOCKET:-}" ]]; then echo "$TMUX_BRIDGE_SOCKET"
  fi
}

detect_socket() {
  # Explicit override
  local override
  override=$(socket_override)
  if [[ -n "$override" ]]; then
    if [[ -S "$override" ]]; then
      echo "$override"
      return
    fi
    die "HAIL_SOCKET=$override is not a valid socket"
  fi

  # Extract from $TMUX (format: "socket_path,pid,session_index")
  if [[ -n "${TMUX:-}" ]]; then
    local socket="${TMUX%%,*}"
    if [[ -S "$socket" ]]; then
      # Verify the socket is actually reachable
      if tmux -S "$socket" list-sessions &>/dev/null; then
        echo "$socket"
        return
      fi
    fi
  fi

  # Fallback: scan tmux server sockets for one that owns $TMUX_PANE
  local pane="${TMUX_PANE:-}"
  if [[ -n "$pane" ]]; then
    local uid
    uid=$(id -u)
    # Check both /tmp and /private/tmp (macOS symlinks /tmp → /private/tmp,
    # but some sandboxed environments only see one or the other)
    local sock_dirs=("/tmp/tmux-${uid}" "/private/tmp/tmux-${uid}")
    for sock_dir in "${sock_dirs[@]}"; do
      [[ -d "$sock_dir" ]] || continue
      for sock in "$sock_dir"/*; do
        [[ -S "$sock" ]] || continue
        if tmux -S "$sock" display-message -t "$pane" -p '#{pane_id}' &>/dev/null; then
          echo "$sock"
          return
        fi
      done
    done
    # Also try the default socket (no -S flag)
    if tmux display-message -t "$pane" -p '#{pane_id}' &>/dev/null; then
      echo "__default__"
      return
    fi
  fi

  # Last resort: try default tmux server
  if tmux list-sessions &>/dev/null; then
    echo "__default__"
    return
  fi

  die "cannot find a reachable tmux server (TMUX=${TMUX:-<unset>}, TMUX_PANE=${TMUX_PANE:-<unset>})"
}

# Resolved once at startup, used by tmx() for all tmux calls.
TMUX_SOCKET=""

init_socket() {
  TMUX_SOCKET=$(detect_socket)
}

# For verbs that work without a server: never fall back to the default server.
init_socket_quiet() {
  TMUX_SOCKET=$(detect_socket 2>/dev/null) || TMUX_SOCKET="__none__"
}

# Wrapper: run tmux with the detected socket.
tmx() {
  if [[ "$TMUX_SOCKET" == "__none__" ]]; then
    return 1
  elif [[ "$TMUX_SOCKET" == "__default__" || -z "$TMUX_SOCKET" ]]; then
    tmux "$@"
  else
    tmux -S "$TMUX_SOCKET" "$@"
  fi
}

usage() {
  cat <<'EOF'
hail — agent-to-agent messaging over tmux

Usage: hail <target> <headline> --kind <kind> [options]
       hail <command> [args...]

Send:
  <target> <headline> --kind k [--bead id] [--re id] [--scope s]
                      [--body <file>|-] [--no-submit] [--force]
                            Write the body to the target's inbox, type a one-line
                            envelope into the pane, press Enter. Prints id=<id>
                            (and bead=<id> comment=<n>). Requires a prior
                            'hail read <target>'. 'send', 'message' and 'msg'
                            are accepted before <target>.
    --kind k                Required. One of: ruling go nogo ask fyi done stop
                            hold block release announce
    --re id                 The message this answers, closes or lifts
    --scope s               What the message applies to (bead, ref, path, action)
    --no-submit             Type the envelope but do not press Enter (the default
                            when the target runs a shell, which would execute it)
    --force                 Skip the dialog and draft guards; submit into a shell
  sent <id>                 delivered | read <time> | injected <time> | inline <time> | unknown
  await <id>... [--timeout SECONDS] [--any]
                            Block until every id (or any, with --any) has a receipt.
                            Default timeout 600. One line per id; exit 0 when
                            satisfied, 1 on timeout. Needs no tmux server.

Receive:
  deliver [--format claude|codex]
                            Print this pane's unread bodies and mark them
                            'injected'. For UserPromptSubmit hooks: JSON with
                            --format, plain text without, nothing when empty.
  brief                     Unread envelopes, my sends without receipt (>2 min),
                            holds/blocks in effect, open obligations on me.
                            Nothing when every section is empty. For SessionStart
                            hooks and humans.
  inbox [--peek] [--all]    Print unread bodies and write receipts (--peek: do not
                            mark; --all: include read ones with their receipt)

Identity:
  name <target> <label>     Label a pane and register label = pane + incarnation
  hello                     Print this pane's incarnation; create one only if it has none
  who [label]               Pane, label, incarnation, last inbox event, last 2 lines
  list                      All panes (target, session, size, process, label, cwd)
  resolve <label>           Pane id for a label
  id                        This pane's id ($TMUX_PANE)

Panes:
  read <target> [lines]     Last N lines of a pane (default 50); sets the read mark
  type <target> <text>      Type text without Enter (verified)
  keys <target> <key>...    Send keys (Enter, Escape, C-c, ...)

  doctor                    Diagnose tmux connectivity
  version                   Print version

Kinds:
  ruling go ask             Create an obligation on the recipient; 'done --re <id>'
                            from the recipient closes it.
  done                      Close one obligation; --re required, --scope optional.
  hold block                Record a hold; 'release --re <id>' by the issuer lifts it.
  release                   Lift a hold; --re required; refused for another issuer.
  nogo fyi announce stop    No state.
  stop hold block release announce are typed in full. The others type the
  envelope with a fetch hint; the body reaches the recipient through the
  UserPromptSubmit hook ('hail deliver') or 'hail inbox'.
  The headline is at most HAIL_ENVELOPE_MAX characters (default 400) for every
  kind; a longer one is refused (exit 2).
  Envelope: [hail kind:<k> from:<label>/<pane> reply:<pane> id:<id> [bead:<id>]
            [re:<id>] [scope:<s>]] <headline> [— hail inbox]

Exit codes:
  1 usage or state error   2 headline over cap   3 label moved (re-register)
  4 target shows a permission dialog   5 target has an unsent draft

Beads:
  With --bead <id>, or a beads issue id in the headline, the body is also posted
  with 'bd comment <id>' and the envelope cites bead:<id>. When bd is missing or
  fails the message is file-only, with one warning.

State ($XDG_STATE_HOME/hail, default ~/.local/state/hail; keep outside repos):
  inbox/<label>/<id>.md, <id>.read     obligations/<label>/<id>
  holds/<id>   identity/<label>   incarnation/<pane>   sent/<label>/<id>

Environment:
  HAIL_SOCKET          tmux server socket (TMUX_BRIDGE_SOCKET accepted)
  HAIL_ENVELOPE_MAX    headline cap in characters (default 400)
  XDG_STATE_HOME       state root (default ~/.local/state)
EOF
  exit 0
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed or not in PATH"
}

# Resolve a target: if it looks like a tmux target (%N, session:win.pane, pure digits),
# use it directly; otherwise treat it as a @name label and resolve.
resolve_target() {
  local target="$1"

  # tmux pane ID like %0, %12
  if [[ "$target" =~ ^%[0-9]+$ ]]; then
    echo "$target"; return
  fi

  # Looks like a tmux target with colon or dot (session:win.pane)
  if [[ "$target" == *:* ]] || [[ "$target" == *.* ]]; then
    echo "$target"; return
  fi

  # Pure numeric — treat as window index
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    echo "$target"; return
  fi

  # Otherwise resolve as a @name label
  resolve_label "$target"
}

# Pane currently wearing a label, or nothing.
label_wearer() {
  tmx list-panes -a -F '#{pane_id} #{@name}' 2>/dev/null \
    | awk -v lbl="$1" '$2 == lbl { print $1; exit }'
}

resolve_label() {
  local label="$1"
  local result
  result=$(label_wearer "$label")
  if [[ -z "$result" ]]; then
    die "no pane found with label '$label'"
  fi
  echo "$result"
}

validate_target() {
  local target="$1"
  tmx display-message -t "$target" -p '#{pane_id}' >/dev/null 2>&1 \
    || die "invalid target: $target"
}

require_args() {
  local need="$1" have="$2" cmd="$3"
  if (( have < need )); then
    die "'$cmd' requires at least $need argument(s). Run 'hail' for usage."
  fi
}

# --- Identity ---
# identity/<label>: the pane that registered the label and its incarnation.
# incarnation/<pane>: id written by `hail hello`; without one the incarnation is
# the pane id plus the start time of the pane's process.

pane_pid_of() { tmx display-message -t "$1" -p '#{pane_pid}' 2>/dev/null || true; }

# An incarnation file records the pane's process id when it was written. It
# counts only while that process is still the pane's: a respawned or relaunched
# pane has a new pid and the file is stale. Without a server the file counts.
fresh_incarnation_file() {
  local pane="$1" f pid rec
  f="$(incarnation_root)/${pane//%/_}"
  [[ -f "$f" ]] || return 1
  pid=$(pane_pid_of "$pane")
  rec=$(hdr "$f" pid)
  if [[ -n "$pid" && -n "$rec" && "$pid" != "$rec" ]]; then return 1; fi
  echo "$f"
}

new_incarnation_id() {
  echo "$(date -u +%m%dT%H%M%S)-$(printf '%04x' $(( RANDOM % 65536 )))"
}

write_incarnation() {
  local pid; pid=$(pane_pid_of "$1")
  mkdir -p "$(incarnation_root)"
  { echo "$2"; [[ -n "$pid" ]] && echo "pid: $pid"; true; } > "$(incarnation_root)/${1//%/_}"
}

incarnation_id_of_file() { head -1 -- "$1"; }

incarnation_for() {
  local pane="$1" f pid start
  if f=$(fresh_incarnation_file "$pane"); then incarnation_id_of_file "$f"; return; fi
  pid=$(pane_pid_of "$pane")
  start=""
  if [[ -n "$pid" ]]; then
    start=$(ps -o lstart= -p "$pid" 2>/dev/null | tr -s ' ' '_' | sed 's/^_//; s/_$//')
  fi
  echo "${pane}@${start:-unknown}"
}

# Label registered for a pane, from identity files only (no tmux needed).
identity_label_for_pane() {
  local pane="$1" f
  [[ -d "$(identity_root)" ]] || return 0
  # Newest registration first.
  while IFS= read -r f; do
    f="$(identity_root)/$f"
    [[ -f "$f" ]] || continue
    if [[ "$(hdr "$f" pane)" == "$pane" ]]; then echo "${f##*/}"; return; fi
  done < <(ls -t "$(identity_root)" 2>/dev/null)
}

# Inbox key for this process's pane: registered label, else the tmux label
# (quietly, if a server is reachable), else the pane id.
self_key() {
  local pane="${TMUX_PANE:-}" label
  [[ -n "$pane" ]] || die "not running inside a tmux pane (\$TMUX_PANE is unset)"
  label=$(identity_label_for_pane "$pane")
  if [[ -z "$label" ]]; then
    label=$( (init_socket_quiet && tmx display-message -t "$pane" -p '#{@name}') 2>/dev/null || true)
  fi
  if [[ -n "$label" ]]; then key_of_label "$label"; else echo "$pane"; fi
}

# Inbox directories for this pane, in SELF_DIRS: the label's and the pane id's.
SELF_DIRS=()
self_dirs() {
  local key pane="${TMUX_PANE:-}"
  key=$(self_key)
  SELF_DIRS=("$(inbox_root)/$key")
  [[ "$key" != "$pane" ]] && SELF_DIRS+=("$(inbox_root)/$pane")
  return 0
}

# --- Commands ---

cmd_list() {
  require_tmux
  printf "%-8s %-16s %-10s %-25s %-10s %s\n" "TARGET" "SESSION:WIN" "SIZE" "PROCESS" "LABEL" "CWD"
  tmx list-panes -a \
    -F '#{pane_id}|#{session_name}|#{window_index}|#{window_name}|#{pane_pid}|#{pane_width}x#{pane_height}|#{@name}|#{pane_current_path}' \
    2>/dev/null | while IFS='|' read -r id sess widx _ pid size label cwd; do
      # Get the actual running process (deepest child of pane pid)
      local proc child_pid
      proc=$(ps -o comm= -p "$pid" 2>/dev/null || echo "?")
      # Find child process (e.g. claude/node running inside zsh) — works on macOS + Linux
      child_pid=$(pgrep -P "$pid" 2>/dev/null | head -1 || true)
      if [[ -n "$child_pid" ]]; then
        local child_proc
        child_proc=$(ps -o comm= -p "$child_pid" 2>/dev/null || true)
        if [[ -n "$child_proc" ]]; then
          proc="$child_proc"
        fi
      fi
      # Shorten home dir in cwd
      cwd="${cwd/#$HOME/~}"
      printf "%-8s %-16s %-10s %-25s %-10s %s\n" \
        "$id" "${sess}:${widx}" "$size" "$proc" "${label:--}" "$cwd"
    done
}

# Type text into a pane and PROVE it arrived, repairing once if it did not.
#
# A vim-mode input box rests in Normal mode and swallows typed text as
# commands until a literal "i" enters Insert mode, so the head of a message
# disappears and the tail still reads as a complete sentence. The mode is not
# reliably observable: codex prints "Vim: Normal" in its status bar, Claude
# Code prints "-- INSERT --" only while inserting and nothing at all in Normal
# mode, and a working agent shows progress there instead of its composer. So
# do not model the mode. Type, look for the text's own opening words in the
# pane, and only if they are absent enter Insert mode, clear what partially
# landed, and type once more.
send_text_verified() {
  local target="$1" text="$2" probe flat i
  # LC_ALL=C keeps both sides byte-oriented: head -c can split a multibyte
  # character, and tr refuses an invalid sequence in a UTF-8 locale. Comparing
  # bytes is sound because a split character's leading bytes still prefix the
  # whole character in the capture. Whitespace goes because the composer wraps.
  probe=$(printf '%s' "$text" | head -c 40 | LC_ALL=C tr -d '[:space:]')
  tmx send-keys -t "$target" -l -- "$text"
  sleep 0.15
  flat=$(tmx capture-pane -t "$target" -p | LC_ALL=C tr -d '[:space:]')
  if [[ -n "$probe" && "$flat" != *"$probe"* ]]; then
    tmx send-keys -t "$target" -l -- "i"
    sleep 0.1
    # A draft may hold several lines and C-u clears one, so clear repeatedly.
    # Retyping over a partial draft is what doubles a message.
    for i in 1 2 3 4 5 6 7 8; do tmx send-keys -t "$target" C-u; done
    sleep 0.15
    tmx send-keys -t "$target" -l -- "$text"
    sleep 0.15
    flat=$(tmx capture-pane -t "$target" -p | LC_ALL=C tr -d '[:space:]')
    if [[ "$flat" != *"$probe"* ]]; then
      printf 'hail: could not confirm the text landed in %s; submitting nothing.\n' "$target" >&2
      printf 'hail: a composer renders only its most recent lines, so a message past\n' >&2
      printf 'hail: roughly 400 characters cannot be verified this way. Put the content\n' >&2
      printf 'hail: on a bead and send a short pointer, which durable coordination wants anyway.\n' >&2
      return 1
    fi
  fi
}

# Refuse to type into a pane that shows a permission dialog (Claude Code
# discards text typed over one and its Enter approves the command) or an
# unsent composer draft that is not a hail envelope.
DIALOG_RE="Yes, and don't ask again|Do you want to proceed|\\(y/n\\)|Allow once|Approve|Esc to cancel"

pane_guard() {
  local target="$1" tail8 last draft
  tail8=$(tmx capture-pane -t "$target" -p -J | grep -v '^[[:space:]]*$' | tail -8 || true)
  if printf '%s\n' "$tail8" | grep -qE "$DIALOG_RE"; then
    die_rc 4 "$target shows a permission/approval dialog; text typed there is discarded and Enter approves it. Resolve the dialog first (or --force)."
  fi
  last=$(printf '%s\n' "$tail8" | tail -1 | sed -E 's/^[[:space:]│┃|]+//; s/[[:space:]│┃|]+$//')
  draft=""
  case "$last" in
    '>'*)  draft="${last#>}" ;;
    '›'*)  draft="${last#›}" ;;
    '❯'*)  draft="${last#❯}" ;;
  esac
  draft="${draft#"${draft%%[![:space:]]*}"}"
  if [[ -n "$draft" && "$draft" != \[hail* && "$draft" != \[tb* && "$draft" != \[tmux-bridge* ]]; then
    die_rc 5 "$target has an unsent draft in its composer: '${draft:0:60}'. Not appending to it (or --force)."
  fi
}

cmd_type() {
  require_args 2 $# "type"
  require_tmux
  local target
  target=$(resolve_target "$1")
  validate_target "$target"
  require_read "$target"

  send_text_verified "$target" "$2" || return 1
  clear_read "$target"
}

# --- Inbox ---
# A message's body lives on disk under the recipient's inbox; only a short
# envelope is typed into the pane. Codex-style compaction keeps every user
# message verbatim but drops tool output, so a fetched body costs nothing after
# the next compaction while a typed body rides on every call forever.

# Inbox key for a pane: its @name label when set, else the pane id.
# Labels survive pane-id shifts after a restart; ids do not.
inbox_key_for() {
  local pane="$1" label
  label=$(tmx display-message -t "$pane" -p '#{@name}' 2>/dev/null || true)
  if [[ -n "$label" ]]; then key_of_label "$label"; else echo "$pane"; fi
}

new_msg_id() {
  printf '%s-%04x' "$(date -u +%m%dT%H%M%S)" $(( RANDOM % 65536 ))
}

is_kind() {
  case "$1" in ruling|go|nogo|ask|fyi|done|stop|hold|block|release|announce) return 0 ;; *) return 1 ;; esac
}

# Control kinds are complete in the envelope and never sit behind a fetch.
is_inline_kind() {
  case "$1" in stop|hold|block|release|announce) return 0 ;; *) return 1 ;; esac
}

# First token that looks like a beads issue id (prefix-hash[.n]). The hash
# must contain a digit so ordinary hyphenated words (tmux-bridge, read-only)
# are not mistaken for an issue.
detect_bead() {
  local tok
  for tok in $(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' ' '); do
    tok="${tok%%.}"
    if [[ "$tok" =~ ^[a-z]+-[a-z0-9]{4,6}(\.[0-9]+)?$ && "${tok#*-}" =~ [0-9] ]]; then
      echo "$tok"; return 0
    fi
  done
  return 1
}

# Post a body to a bead, opportunistically. Prints the comment number (or
# nothing) on stdout; returns nonzero on any failure.
post_bead_comment() {
  local bead="$1" body_file="$2" out num=""
  command -v bd >/dev/null 2>&1 || return 1
  out=$(bd comment "$bead" --file "$body_file" --json 2>/dev/null) || return 1
  num=$(printf '%s' "$out" | grep -oE '"id"[[:space:]]*:[[:space:]]*"?[0-9]+' | head -1 | grep -oE '[0-9]+$' || true)
  echo "$num"
}

# Resolve a send target. A label registered with `hail name` must still be on
# the registered pane with the registered incarnation; otherwise exit 3.
resolve_send_target() {
  local target_arg="$1" idf reg_pane reg_inc now_pane now_inc
  if [[ "$target_arg" =~ ^%[0-9]+$ || "$target_arg" == *:* || "$target_arg" == *.* || "$target_arg" =~ ^[0-9]+$ ]]; then
    echo "$target_arg"; return
  fi
  idf="$(identity_root)/$(key_of_label "$target_arg")"
  if [[ ! -f "$idf" ]]; then resolve_label "$target_arg"; return; fi
  reg_pane=$(hdr "$idf" pane); reg_inc=$(hdr "$idf" incarnation)
  now_pane=$(label_wearer "$target_arg")
  if [[ -n "$now_pane" && "$now_pane" != "$reg_pane" ]]; then
    die_rc 3 "label $target_arg moved: registered on $reg_pane, now on $now_pane — run hail name to re-register"
  fi
  now_inc=$(incarnation_for "$reg_pane")
  if [[ "$now_inc" != "$reg_inc" ]]; then
    die_rc 3 "label $target_arg moved: registered on $reg_pane ($reg_inc), now on $reg_pane ($now_inc) — run hail name to re-register"
  fi
  echo "$reg_pane"
}

cmd_send() {
  require_tmux
  local kind="" bead="" body_src="" re="" scope="" submit=true force=false
  local target_arg="" text="" positional=()
  while (( $# )); do
    case "$1" in
      --kind) [[ $# -ge 2 ]] || die "--kind needs a value"; kind="$2"; shift 2 ;;
      --kind=*) kind="${1#*=}"; shift ;;
      --bead) [[ $# -ge 2 ]] || die "--bead needs a value"; bead="$2"; shift 2 ;;
      --bead=*) bead="${1#*=}"; shift ;;
      --body) [[ $# -ge 2 ]] || die "--body needs a file or -"; body_src="$2"; shift 2 ;;
      --body=*) body_src="${1#*=}"; shift ;;
      --re) [[ $# -ge 2 ]] || die "--re needs a message id"; re="$2"; shift 2 ;;
      --re=*) re="${1#*=}"; shift ;;
      --scope) [[ $# -ge 2 ]] || die "--scope needs a value"; scope="$2"; shift 2 ;;
      --scope=*) scope="${1#*=}"; shift ;;
      --no-submit) submit=false; shift ;;
      --force) force=true; shift ;;
      --) shift; positional+=("$@"); break ;;
      -*) die "unknown option for send: $1" ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  require_args 2 ${#positional[@]} "send"
  target_arg="${positional[0]}"; text="${positional[1]}"
  [[ -n "$kind" ]] || die "--kind is required ($KINDS)"
  is_kind "$kind" || die "unknown kind '$kind' ($KINDS)"
  [[ "$re" == */* ]] && die "--re must be a message id"
  [[ -n "$scope" && "$scope" == *$'\n'* ]] && die "--scope must be one line"

  local max=${HAIL_ENVELOPE_MAX:-400}
  if (( ${#text} > max )); then
    die_rc 2 "headline is ${#text} characters; the cap is $max (HAIL_ENVELOPE_MAX). Shorten it and put the rest in --body or on a bead."
  fi
  case "$kind" in
    done|release) [[ -n "$re" ]] || die "--kind $kind requires --re <id>" ;;
  esac

  local target
  target=$(resolve_send_target "$target_arg")
  validate_target "$target"
  require_read "$target"

  # Sender identity
  local sender_pane="${TMUX_PANE:-}"
  if [[ -z "$sender_pane" ]]; then
    die "not running inside a tmux pane (\$TMUX_PANE is unset)"
  fi
  local sender_label from from_key
  sender_label=$(tmx display-message -t "$sender_pane" -p '#{@name}' 2>/dev/null || true)
  if [[ -n "$sender_label" ]]; then
    from="${sender_label}/${sender_pane}"; from_key=$(key_of_label "$sender_label")
  else
    from="$sender_pane"; from_key="$sender_pane"
  fi
  local key
  key=$(inbox_key_for "$target")

  # State preconditions, checked before anything is typed.
  local holdf="" oblf=""
  case "$kind" in
    release)
      holdf="$(holds_root)/$re"
      [[ -f "$holdf" ]] || die "no hold or block in effect with id $re"
      local issuer; issuer=$(hdr "$holdf" issuer)
      [[ "$issuer" == "$from_key" ]] || die "hold $re was issued by $issuer, not by $from_key; only its issuer can release it"
      ;;
    done)
      oblf="$(obligations_root)/$from_key/$re"
      [[ -f "$oblf" ]] || die "no open obligation $re on $from_key (see: hail brief)"
      ;;
  esac

  $force || pane_guard "$target"

  # A shell would execute the envelope: type it there, but do not press Enter.
  local cur
  cur=$(tmx display-message -t "$target" -p '#{pane_current_command}' 2>/dev/null || true)
  if $submit && ! $force; then
    case "$cur" in
      bash|zsh|sh|fish|dash|ksh|tcsh|csh)
        submit=false
        echo "hail: $target runs $cur, a shell, so the envelope was typed but not submitted. A shell cannot receive messages; do not press Enter there. (--force submits anyway)" >&2 ;;
    esac
  fi

  # Body: --body file, stdin when '-', else the text itself.
  local body
  if [[ -z "$body_src" ]]; then
    body="$text"
  elif [[ "$body_src" == "-" ]]; then
    body=$(cat)
  else
    [[ -r "$body_src" ]] || die "cannot read body file: $body_src"
    body=$(cat -- "$body_src")
  fi

  # Bead-first: explicit --bead, else the first issue id named in the text.
  if [[ -z "$bead" ]]; then bead=$(detect_bead "$text" || true); fi

  local id dir file now
  id=$(new_msg_id)
  now=$(utc_now)
  dir="$(inbox_root)/$key"
  mkdir -p "$dir"
  file="$dir/$id.md"

  local comment="" bead_line=""
  if [[ -n "$bead" ]]; then
    local tmp
    tmp=$(mktemp "${TMPDIR:-/tmp}/hail-body.XXXXXX")
    printf '%s\n' "$body" > "$tmp"
    if comment=$(post_bead_comment "$bead" "$tmp"); then
      bead_line="bead: $bead${comment:+ (comment $comment)}"
    else
      comment=""
      bead_line="bead: $bead (not posted)"
      echo "hail: warning: could not post to bead $bead with bd; message is file-only" >&2
    fi
    rm -f "$tmp"
  fi

  {
    echo "from: $from"
    echo "reply: $sender_pane"
    echo "kind: $kind"
    echo "id: $id"
    echo "time: $now"
    [[ -n "$bead_line" ]] && echo "$bead_line"
    [[ -n "$comment" ]] && echo "see: bd show $bead"
    [[ -n "$re" ]] && echo "re: $re"
    [[ -n "$scope" ]] && echo "scope: $scope"
    echo "ask: $text"
    echo
    printf '%s\n' "$body"
  } > "$file"

  # A control kind is complete in the envelope: pre-write its receipt so
  # deliver/inbox do not hand the body over a second time. sent/await/brief
  # still see the message and the holds state is unaffected.
  if is_inline_kind "$kind"; then echo "inline $now" > "$dir/$id.read"; fi

  # Envelope. Never truncated: the headline was checked against the cap above.
  local head="[hail kind:${kind} from:${from} reply:${sender_pane} id:${id}${bead:+ bead:$bead}${re:+ re:$re}${scope:+ scope:$scope}]"
  local envelope
  if is_inline_kind "$kind"; then
    envelope="${head} ${text}"
  else
    envelope="${head} ${text} — hail inbox"
  fi

  local rc=0
  if ! send_text_verified "$target" "$envelope"; then
    echo "hail: envelope not confirmed in $target; body is at $file" >&2
    rc=1
  elif $submit; then
    sleep 0.3
    tmx send-keys -t "$target" Enter
    clear_read "$target"
  fi
  # else: keep the read mark for the Enter the caller sends.

  # State transitions, recorded once the envelope is delivered (or written).
  case "$kind" in
    hold|block)
      mkdir -p "$(holds_root)"
      {
        echo "id: $id"; echo "kind: $kind"; echo "issuer: $from_key"; echo "to: $key"
        echo "scope: $scope"; echo "time: $now"; [[ -n "$re" ]] && echo "re: $re"
        echo "headline: $text"
      } > "$(holds_root)/$id"
      ;;
    release) rm -f "$holdf" ;;
    go|ruling|ask)
      mkdir -p "$(obligations_root)/$key"
      {
        echo "id: $id"; echo "kind: $kind"; echo "issuer: $from_key"; echo "to: $key"
        echo "scope: $scope"; echo "time: $now"; [[ -n "$re" ]] && echo "re: $re"
        echo "headline: $text"
      } > "$(obligations_root)/$key/$id"
      ;;
    done) rm -f "$oblf" ;;
  esac
  mkdir -p "$(sent_root)/$from_key"
  {
    echo "id: $id"; echo "kind: $kind"; echo "to: $key"; echo "epoch: $(date +%s)"
    echo "headline: $text"
  } > "$(sent_root)/$from_key/$id"

  echo "id=$id"
  [[ -n "$bead" && -n "$comment" ]] && echo "bead=$bead comment=$comment"
  return "$rc"
}

# Receipt text for a message: "read <time>" | "injected <time>" | "inline
# <time>". The .read file holds a bare time (inbox), "injected <time>"
# (deliver) or "inline <time>" (a control kind, complete in the envelope).
receipt_status_of_file() {
  local c; c=$(cat -- "$1")
  case "$c" in injected\ *|inline\ *) echo "$c" ;; *) echo "read $c" ;; esac
}

cmd_inbox() {
  local peek=false all=false
  while (( $# )); do
    case "$1" in
      --peek) peek=true ;;
      --all) all=true ;;
      *) die "unknown option for inbox: $1" ;;
    esac
    shift
  done
  local shown=0 f id dir
  self_dirs
  for dir in "${SELF_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      id="${f##*/}"; id="${id%.md}"
      if [[ -f "$dir/$id.read" ]] && ! $all; then continue; fi
      (( shown > 0 )) && echo "---"
      [[ -f "$dir/$id.read" ]] && echo "receipt: $(receipt_status_of_file "$dir/$id.read")"
      cat -- "$f"
      shown=$(( shown + 1 ))
      if ! $peek && [[ ! -f "$dir/$id.read" ]]; then
        utc_now > "$dir/$id.read"
      fi
    done
  done
  (( shown == 0 )) && echo "(inbox empty)"
  return 0
}

# Escape a string for a JSON string literal. Control characters other than
# newline, tab and CR are dropped.
json_escape() {
  local s
  s=$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013\014\016-\037')
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  printf '%s' "$s"
}

# Drain hook JSON from stdin when something is piped in; never block on it.
drain_stdin() {
  [[ -t 0 ]] && return 0
  read -r -t 1 -d '' _ 2>/dev/null || true
}

# Print unread bodies for this pane and mark them "injected <time>". For the
# UserPromptSubmit hook: silent when there is nothing, JSON with --format.
cmd_deliver() {
  local format=""
  while (( $# )); do
    case "$1" in
      --format) [[ $# -ge 2 ]] || die "--format needs claude or codex"; format="$2"; shift 2 ;;
      --format=*) format="${1#*=}"; shift ;;
      *) die "unknown option for deliver: $1" ;;
    esac
  done
  case "$format" in ""|claude|codex) ;; *) die "--format must be claude or codex" ;; esac
  drain_stdin
  local text="" f id dir n=0
  self_dirs
  for dir in "${SELF_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      id="${f##*/}"; id="${id%.md}"
      [[ -f "$dir/$id.read" ]] && continue
      (( n > 0 )) && text+=$'\n---\n'
      text+=$(cat -- "$f")
      n=$(( n + 1 ))
      echo "injected $(utc_now)" > "$dir/$id.read"
    done
  done
  (( n == 0 )) && return 0
  if [[ -n "$format" ]]; then
    printf '{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"%s"}}\n' "$(json_escape "$text")"
  else
    printf '%s\n' "$text"
  fi
}

# One line of at most 200 characters.
brief_line() {
  local s="$1"
  if (( ${#s} > 200 )); then s="${s:0:199}…"; fi
  printf '%s\n' "$s"
}

# Envelope-style line for a message file.
envelope_of_file() {
  local f="$1" from bead re scope
  from=$(hdr "$f" from); from="${from%%/*}"
  bead=$(hdr "$f" bead); bead="${bead%% *}"
  re=$(hdr "$f" re); scope=$(hdr "$f" scope)
  echo "[hail $(hdr "$f" kind) from:$from id:$(hdr "$f" id)${bead:+ bead:$bead}${re:+ re:$re}${scope:+ scope:$scope}] $(hdr "$f" ask)"
}

# One line when this pane's registered label no longer matches its incarnation
# (the pane's process was restarted). Silent without a reachable tmux server.
label_status_line() {
  local pane="${TMUX_PANE:-}" label idf reg now
  label=$(identity_label_for_pane "$pane")
  [[ -n "$label" ]] || return 0
  idf="$(identity_root)/$(key_of_label "$label")"
  reg=$(hdr "$idf" incarnation)
  init_socket_quiet
  [[ "$TMUX_SOCKET" != "__none__" ]] || return 0
  now=$(incarnation_for "$pane" 2>/dev/null) || return 0
  if [[ -n "$now" && "$now" != "$reg" ]]; then
    echo "label $label: pane restarted — run: hail name \"\$(hail id)\" $label"
  fi
}

cmd_brief() {
  drain_stdin
  local me out="" lines="" n f id dir
  me=$(self_key)
  lines=$(label_status_line)
  [[ -n "$lines" ]] && out+="$lines"$'\n'

  # inbox
  n=0; lines=""
  self_dirs
  for dir in "${SELF_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.md; do
      [[ -f "$f" ]] || continue
      id="${f##*/}"; id="${id%.md}"
      [[ -f "$dir/$id.read" ]] && continue
      lines+="$(brief_line "  $(envelope_of_file "$f")")"$'\n'
      n=$(( n + 1 ))
    done
  done
  (( n > 0 )) && out+="inbox ($n unread)"$'\n'"$lines"

  # my sends without receipt, older than 2 minutes
  n=0; lines=""
  local now epoch age to
  now=$(date +%s)
  dir="$(sent_root)/$me"
  if [[ -d "$dir" ]]; then
    for f in "$dir"/*; do
      [[ -f "$f" ]] || continue
      id="${f##*/}"; to=$(hdr "$f" to)
      [[ -f "$(inbox_root)/$to/$id.read" ]] && continue
      epoch=$(hdr "$f" epoch); age=$(( now - ${epoch:-0} ))
      (( age >= 120 )) || continue
      lines+="$(brief_line "  [hail $(hdr "$f" kind) to:$to id:$id] $(hdr "$f" headline) ($(( age / 60 ))m, no receipt)")"$'\n'
      n=$(( n + 1 ))
    done
  fi
  (( n > 0 )) && out+="my sends without receipt ($n)"$'\n'"$lines"

  # holds / blocks in effect
  n=0; lines=""
  dir="$(holds_root)"
  if [[ -d "$dir" ]]; then
    for f in "$dir"/*; do
      [[ -f "$f" ]] || continue
      local scope; scope=$(hdr "$f" scope)
      lines+="$(brief_line "  [hail $(hdr "$f" kind) from:$(hdr "$f" issuer) to:$(hdr "$f" to) id:$(hdr "$f" id)${scope:+ scope:$scope}] $(hdr "$f" headline) (since $(hdr "$f" time))")"$'\n'
      n=$(( n + 1 ))
    done
  fi
  (( n > 0 )) && out+="holds / blocks in effect ($n)"$'\n'"$lines"

  # open obligations on me
  n=0; lines=""
  dir="$(obligations_root)/$me"
  if [[ -d "$dir" ]]; then
    for f in "$dir"/*; do
      [[ -f "$f" ]] || continue
      local scope; scope=$(hdr "$f" scope)
      lines+="$(brief_line "  [hail $(hdr "$f" kind) from:$(hdr "$f" issuer) id:$(hdr "$f" id)${scope:+ scope:$scope}] $(hdr "$f" headline) — hail done --re $(hdr "$f" id)")"$'\n'
      n=$(( n + 1 ))
    done
  fi
  (( n > 0 )) && out+="open obligations on me ($n)"$'\n'"$lines"

  [[ -n "$out" ]] && printf '%s' "$out"
  return 0
}

# Receipt for a message id: prints the contents of <id>.read and returns 0
# when it exists; returns 1 otherwise. Searches every inbox because the sender
# does not need to remember which label it sent to.
receipt_time() {
  local id="$1" root f
  root=$(inbox_root)
  for f in "$root"/*/"$id".read; do
    [[ -f "$f" ]] || continue
    receipt_status_of_file "$f"
    return 0
  done
  return 1
}

cmd_sent() {
  require_args 1 $# "sent"
  local id="$1" root f when
  if when=$(receipt_time "$id"); then
    echo "$when"
    return 0
  fi
  root=$(inbox_root)
  for f in "$root"/*/"$id".md; do
    [[ -f "$f" ]] || continue
    echo "delivered"
    return 0
  done
  echo "unknown"
  return 0
}

# Block until every id (or any, with --any) has a receipt. The only verb that
# waits (DESIGN.md: "no polling helper"). Wakes on the receipt file with
# fswatch when it is on PATH and re-checks at least every 5 s so an event that
# lands between a check and the watch starting cannot be missed; without
# fswatch it polls once a second.
cmd_await() {
  local timeout=600 any=false ids=()
  while (( $# )); do
    case "$1" in
      --timeout) [[ $# -ge 2 ]] || die "--timeout needs a value"; timeout="$2"; shift 2 ;;
      --timeout=*) timeout="${1#*=}"; shift ;;
      --any) any=true; shift ;;
      --) shift; ids+=("$@"); break ;;
      -*) die "unknown option for await: $1" ;;
      *) ids+=("$1"); shift ;;
    esac
  done
  require_args 1 ${#ids[@]} "await"
  [[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a whole number of seconds"

  local root watcher="" deadline now remaining wake
  root=$(inbox_root)
  mkdir -p "$root"
  command -v fswatch >/dev/null 2>&1 && watcher=fswatch
  deadline=$(( $(date +%s) + timeout ))

  # One line per id: "<id> read <time>" | "<id> injected <time>" |
  # "<id> timeout" | "<id> pending". pending only appears with --any, for the
  # ids not yet read when another was.
  report() {
    local outcome="$1" i when
    for i in "${ids[@]}"; do
      if when=$(receipt_time "$i"); then echo "$i $when"; else echo "$i $outcome"; fi
    done
  }
  satisfied() {
    local i n=0
    for i in "${ids[@]}"; do receipt_time "$i" >/dev/null && n=$(( n + 1 )); done
    if $any; then (( n > 0 )); else (( n == ${#ids[@]} )); fi
  }

  while :; do
    if satisfied; then report pending; return 0; fi
    now=$(date +%s)
    remaining=$(( deadline - now ))
    if (( remaining <= 0 )); then report timeout; return 1; fi
    if [[ "$watcher" == fswatch ]]; then
      wake=$remaining; (( wake > 5 )) && wake=5
      local pid
      exec 9< <(fswatch -1 -r -- "$root" 2>/dev/null)
      pid=$!
      read -r -t "$wake" -u 9 _ || true
      kill "$pid" 2>/dev/null || true
      exec 9<&-
    else
      sleep 1
    fi
  done
}

cmd_read() {
  require_tmux
  require_args 1 $# "read"
  local target
  target=$(resolve_target "$1")
  validate_target "$target"
  local lines="${2:-50}"

  # -S moves the start into scrollback but the capture still ends at the bottom
  # of the screen: drop the blank rows under the cursor, then keep the last N.
  tmx capture-pane -t "$target" -p -J -S "-${lines}" \
    | awk '{ l[NR] = $0; if ($0 !~ /^[[:space:]]*$/) last = NR } END { for (i = 1; i <= last; i++) print l[i] }' \
    | tail -n "$lines"
  mark_read "$target"
}

cmd_keys() {
  require_args 2 $# "keys"
  require_tmux
  local target
  target=$(resolve_target "$1")
  validate_target "$target"
  require_read "$target"
  shift

  for key in "$@"; do
    tmx send-keys -t "$target" "$key"
  done
  clear_read "$target"
}

cmd_name() {
  require_args 2 $# "name"
  require_tmux
  local target label="$2"
  target=$(resolve_target "$1")
  validate_target "$target"
  [[ "$label" == *$'\n'* ]] && die "label must be one line"

  tmx set-option -p -t "$target" @name "$label"
  # Registering mints the incarnation, so a later `hello` cannot invalidate it.
  local inc; inc=$(new_incarnation_id)
  write_incarnation "$target" "$inc"
  mkdir -p "$(identity_root)"
  {
    echo "label: $label"
    echo "pane: $target"
    echo "incarnation: $inc"
    echo "time: $(utc_now)"
  } > "$(identity_root)/$(key_of_label "$label")"
}

# Idempotent: prints the pane's incarnation, creating one only when the pane
# has none (or only a stale one from a previous process).
cmd_hello() {
  local pane="${TMUX_PANE:-}" inc f
  [[ -n "$pane" ]] || die "not running inside a tmux pane (\$TMUX_PANE is unset)"
  init_socket_quiet
  if f=$(fresh_incarnation_file "$pane" 2>/dev/null); then incarnation_id_of_file "$f"; return 0; fi
  inc=$(new_incarnation_id)
  write_incarnation "$pane" "$inc"
  echo "$inc"
}

# Newest event time in an inbox directory: a message's time or a receipt.
last_inbox_event() {
  local dir="$1" f
  [[ -d "$dir" ]] || return 0
  # shellcheck disable=SC2012  # newest first by mtime; ids have no spaces
  f=$(ls -t "$dir" 2>/dev/null | head -1)
  [[ -n "$f" ]] || return 0
  f="$dir/$f"
  case "$f" in
    *.read) sed 's/^injected //' "$f" ;;
    *.md) hdr "$f" time ;;
  esac
}

cmd_who() {
  require_tmux
  local label="${1:-}" pane="" idf reg_pane="" reg_inc="" wearer=""
  if [[ -z "$label" ]]; then
    pane="${TMUX_PANE:-}"
    [[ -n "$pane" ]] || die "not running inside a tmux pane (\$TMUX_PANE is unset)"
    label=$(identity_label_for_pane "$pane")
    [[ -n "$label" ]] || label=$(tmx display-message -t "$pane" -p '#{@name}' 2>/dev/null || true)
  fi
  if [[ -n "$label" ]]; then
    idf="$(identity_root)/$(key_of_label "$label")"
    if [[ -f "$idf" ]]; then reg_pane=$(hdr "$idf" pane); reg_inc=$(hdr "$idf" incarnation); fi
    wearer=$(label_wearer "$label")
    [[ -n "$pane" ]] || pane="${wearer:-$reg_pane}"
  fi
  [[ -n "$pane" ]] || die "no pane found with label '$label'"

  echo "pane: $pane"
  echo "label: ${label:--}"
  [[ -n "$reg_pane" ]] && echo "registered: $reg_pane"
  [[ -n "$wearer" ]] && echo "wearing: $wearer"
  local now_inc; now_inc=$(incarnation_for "$pane")
  echo "incarnation: $now_inc"
  [[ -n "$reg_inc" ]] && echo "registered incarnation: $reg_inc"
  if [[ -n "$wearer" && -n "$reg_pane" && "$wearer" != "$reg_pane" ]]; then
    echo "status: label moved to $wearer; registered on $reg_pane — run: hail name $wearer $label"
  elif [[ -n "$reg_inc" && "$now_inc" != "$reg_inc" ]]; then
    echo "status: pane restarted since registration — run: hail name \"\$(hail id)\" $label"
  elif [[ -n "$reg_inc" ]]; then
    echo "status: ok"
  fi
  local key; key=$(key_of_label "${label:-$pane}")
  echo "last inbox event: $(last_inbox_event "$(inbox_root)/$key")"
  echo "pane tail:"
  if tmx display-message -t "$pane" -p '#{pane_id}' >/dev/null 2>&1; then
    tmx capture-pane -t "$pane" -p -J | grep -v '^[[:space:]]*$' | tail -2 | sed 's/^/  /'
  else
    echo "  (pane $pane not found)"
  fi
  return 0
}

cmd_resolve() {
  require_args 1 $# "resolve"
  require_tmux
  resolve_label "$1"
}

cmd_id() {
  if [[ -z "${TMUX_PANE:-}" ]]; then
    die "not running inside a tmux pane (\$TMUX_PANE is unset)"
  fi
  echo "$TMUX_PANE"
}

cmd_doctor() {
  require_tmux
  local ok=true

  echo "hail doctor v${VERSION}"
  echo "---"

  # Environment
  echo "TMUX_PANE:          ${TMUX_PANE:-<unset>}"
  echo "TMUX:               ${TMUX:-<unset>}"
  echo "HAIL_SOCKET:        ${HAIL_SOCKET:-<unset>}"
  [[ -n "${TMUX_BRIDGE_SOCKET:-}" ]] && echo "TMUX_BRIDGE_SOCKET: $TMUX_BRIDGE_SOCKET (fallback)"

  # Socket from $TMUX
  if [[ -n "${TMUX:-}" ]]; then
    local env_socket="${TMUX%%,*}"
    if [[ -S "$env_socket" ]]; then
      if tmux -S "$env_socket" list-sessions &>/dev/null; then
        echo "\$TMUX socket:       $env_socket (reachable)"
      else
        echo "\$TMUX socket:       $env_socket (exists but not responding)"
        ok=false
      fi
    else
      echo "\$TMUX socket:       $env_socket (MISSING — stale env)"
      ok=false
    fi
  fi

  # Detected socket
  echo "---"
  local detected
  detected=$(detect_socket 2>/dev/null || echo "__failed__")
  if [[ "$detected" == "__failed__" ]]; then
    echo "Detected socket:    FAILED — no reachable tmux server found"
    ok=false
  elif [[ "$detected" == "__default__" ]]; then
    echo "Detected socket:    (default tmux server)"
  else
    echo "Detected socket:    $detected"
  fi

  # Pane visibility
  echo "---"
  if [[ -n "${TMUX_PANE:-}" && "$detected" != "__failed__" ]]; then
    if tmx display-message -t "$TMUX_PANE" -p '#{pane_id}' &>/dev/null; then
      echo "This pane ($TMUX_PANE): visible to server"
    else
      echo "This pane ($TMUX_PANE): NOT visible to server"
      ok=false
    fi
  fi

  # Pane count
  if [[ "$detected" != "__failed__" ]]; then
    local count
    count=$(tmx list-panes -a -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ')
    echo "Total panes:        $count"
    local labeled
    labeled=$(tmx list-panes -a -F '#{@name}' 2>/dev/null | grep -cv '^$' || echo 0)
    echo "Labeled panes:      $labeled"
  fi

  echo "---"
  if $ok; then
    echo "Status: OK"
  else
    echo "Status: ISSUES DETECTED"
    echo ""
    echo "Likely cause: \$TMUX env var is stale (terminal was restarted)."
    echo "Fix: re-source tmux env or set HAIL_SOCKET explicitly."
    return 1
  fi
}

# --- Main ---

[[ $# -eq 0 ]] && usage

# These need no tmux server: they are files-only (a hook must not depend on one).
case "$1" in
  id)      shift; cmd_id "$@"; exit ;;
  -h|--help|help) usage ;;
  version) echo "hail $VERSION"; exit ;;
  sent)    shift; cmd_sent "$@"; exit ;;
  await)   shift; cmd_await "$@"; exit ;;
  deliver) shift; cmd_deliver "$@"; exit ;;
  brief)   shift; cmd_brief "$@"; exit ;;
  hello)   shift; cmd_hello "$@"; exit ;;
  inbox)   shift; cmd_inbox "$@"; exit ;;
esac

# All other commands need the socket
require_tmux
init_socket

case "$1" in
  list)    shift; cmd_list "$@" ;;
  type)    shift; cmd_type "$@" ;;
  send|message|msg) shift; cmd_send "$@" ;;
  read)    shift; cmd_read "$@" ;;
  keys)    shift; cmd_keys "$@" ;;
  name)    shift; cmd_name "$@" ;;
  who)     shift; cmd_who "$@" ;;
  resolve) shift; cmd_resolve "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  -*)      die "unknown option: $1. Run 'hail' for usage." ;;
  *)
    # Bare form: hail <target> <headline> [options]
    if (( $# >= 2 )); then cmd_send "$@"
    else die "unknown command: $1. Run 'hail' for usage."
    fi ;;
esac
